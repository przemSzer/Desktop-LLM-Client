<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="5.0" 
   stylesheets="@../../../../../../css/styles.css"
   xmlns="http://javafx.com/javafx/24.0.1" 
   xmlns:fx="http://javafx.com/fxml/1">
   
   <HBox alignment="CENTER_LEFT" spacing="10.0">
      <Button fx:id="addFileButton" text="Add File" />
      <Button fx:id="clearFilesButton" text="Clear All" />
      <Label fx:id="filesCountLabel" styleClass="file-count-label" text="No files attached" />
      <opaqueInsets>
         <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
      </opaqueInsets>
   </HBox>
   
   <ListView fx:id="attachedFilesListView" maxHeight="200.0" minHeight="50.0" prefHeight="80.0" VBox.vgrow="NEVER" />
   
</VBox>
