<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="100.0" prefWidth="400.0" spacing="10.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1">
   
   <Label fx:id="messageType" style="-fx-text-fill: blue; -fx-font-weight: bold;" text="You" wrapText="true" />
   
   <HBox alignment="CENTER_LEFT" spacing="10.0" VBox.vgrow="ALWAYS">
      <Label fx:id="content" maxWidth="Infinity" minWidth="0.0" prefWidth="0.0" style="-fx-text-fill: black; -fx-font-weight: bold; -fx-font-size: 16px;" text="Some example text" wrapText="true" HBox.hgrow="ALWAYS" />
      
      <VBox fx:id="messageActions" alignment="CENTER" spacing="5.0">
         <Button fx:id="copyMessageButton" style="-fx-font-size: 11px;" text="Copy" />
      </VBox>
   </HBox>
   
</VBox>
