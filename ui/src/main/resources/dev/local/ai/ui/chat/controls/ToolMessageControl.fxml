<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import dev.local.ai.ui.chat.controls.SelectableText?>

<VBox styleClass="message-bubble, tool-message" stylesheets="@../../../../../../css/styles.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <TitledPane animated="false" text="Tool" VBox.vgrow="SOMETIMES">
      <content>
         <VBox spacing="10.0">
            
            <HBox alignment="CENTER_LEFT" spacing="10.0" VBox.vgrow="SOMETIMES">
               <SelectableText fx:id="toolContent" styleClass="selectable-text" text="Tool result" HBox.hgrow="SOMETIMES" />
               
               <VBox fx:id="messageActions" alignment="TOP_RIGHT" spacing="5.0">
                  <Button fx:id="copyMessageButton" styleClass="btn-copy" minWidth="60.0" text="Copy" />
               </VBox>
            </HBox>
            
         </VBox>
      </content>
   </TitledPane>
</VBox>
