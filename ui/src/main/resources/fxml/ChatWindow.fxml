<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.effect.Blend?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox minHeight="400.0" minWidth="300.0" prefHeight="800.0" prefWidth="900.0" spacing="10" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dev.local.ai.ui.chat.controller.ChatController">
    <padding>
        <Insets bottom="10" left="10" right="10" top="10" />
    </padding>
    
    <children>
      <Accordion minHeight="-Infinity" VBox.vgrow="SOMETIMES">
        <panes>
          <TitledPane animated="false" expanded="false" minHeight="100.0" minWidth="-Infinity" text="System message" textOverrun="CLIP">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0">
                     <children>
                        <TextArea fx:id="systemMessageTextArea" minHeight="50.0" minWidth="100.0" promptText="Enter system message here" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="10.0" />
                     </children>
                  </AnchorPane>
            </content>
          </TitledPane>
        </panes>
      </Accordion>
      <SplitPane dividerPositions="0.77" orientation="VERTICAL" VBox.vgrow="ALWAYS">
        <items>
          <AnchorPane minHeight="100.0" minWidth="100.0">
               <children>
                  <ListView fx:id="chatListView" prefHeight="442.0" prefWidth="873.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="5.0" />
               </children>
            </AnchorPane>
          <AnchorPane prefHeight="290.0" prefWidth="873.0">
               <children>
                  <VBox AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
                     <children>
                          
                          <!-- Input area -->
                          <HBox fx:id="promptHBox" alignment="CENTER_LEFT" nodeOrientation="LEFT_TO_RIGHT" spacing="10" VBox.vgrow="ALWAYS">
                           <TextArea fx:id="messageInput" HBox.hgrow="SOMETIMES" />
                              <Button fx:id="sendButton" text="Send" />
                           <VBox.margin>
                              <Insets right="10.0" />
                           </VBox.margin>
                          </HBox>
                          
                          <!-- Status label -->
                          <Label fx:id="statusLabel" style="-fx-text-fill: gray; -fx-font-size: 12px;" text="Ready" />
                          
                          <!-- Command buttons -->
                          <HBox alignment="CENTER" spacing="10">
                              <Button fx:id="undoButton" disable="true" text="Undo" />
                              <Button fx:id="redoButton" disable="true" text="Redo" />
                              <Button fx:id="clearChatButton" text="Clear Chat" />
                          </HBox>
                        <VBox fx:id="promptToolsHBox" />
                     </children>
                  </VBox>
               </children>
               <effect>
                  <Blend />
               </effect>
            </AnchorPane>
        </items>
      </SplitPane>
    </children>
    
</VBox>
