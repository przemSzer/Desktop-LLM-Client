<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.controlsfx.control.SearchableComboBox?>

<fx:root type="VBox" maxWidth="Infinity" spacing="8.0" stylesheets="@../../../../../../css/styles.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="8.0">
         <children>
            <SearchableComboBox fx:id="connectionComboBox"
               maxWidth="Infinity" minWidth="140.0" prefWidth="220.0"
               promptText="Select a connection..." HBox.hgrow="ALWAYS" />
            <Button fx:id="manageConnectionsButton" minWidth="-Infinity" text="Connections..." />
         </children>
      </HBox>
      <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="8.0">
         <children>
            <ProgressIndicator
               fx:id="loadingIndicator" managed="false" minHeight="-Infinity" minWidth="-Infinity"
               prefHeight="20.0" prefWidth="20.0" visible="false" />
            <SearchableComboBox fx:id="modelComboBox"
               maxWidth="Infinity" minWidth="140.0" prefWidth="220.0"
               promptText="Select a model..." visibleRowCount="10" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="4.0" left="4.0" right="4.0" top="4.0" />
   </padding>
</fx:root>
