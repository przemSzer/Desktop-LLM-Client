<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox minHeight="400.0" minWidth="300.0" prefHeight="471.0" prefWidth="895.0" spacing="10" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ui.controller.ChatController">
    <padding>
        <Insets bottom="10" left="10" right="10" top="10" />
    </padding>
    
    <children>
      <ListView fx:id="chatListView" VBox.vgrow="ALWAYS" />
        
        <!-- Input area -->
        <HBox fx:id="promptHBox" alignment="CENTER_LEFT" nodeOrientation="LEFT_TO_RIGHT" spacing="10" VBox.vgrow="ALWAYS">
         <TextArea fx:id="messageInput" HBox.hgrow="ALWAYS" />
            <Button fx:id="sendButton" onAction="#handleSendMessage" text="Send" />
        </HBox>
      <VBox fx:id="promptToolsHBox" maxHeight="-Infinity" minHeight="-Infinity" prefHeight="70.0" VBox.vgrow="NEVER" />
    </children>
    
</VBox>
