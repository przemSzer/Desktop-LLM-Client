<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.local.ai</groupId>
    <artifactId>agent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>Agent Project</name>
    <description>A multi-module Java project with core and UI components</description>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <jpro.version>0.5.7</jpro.version>
        <javafx.version>26.0.1</javafx.version>
        <!-- Dependency versions -->
        <typesafe-config.version>1.4.4</typesafe-config.version>
        <logback.version>1.5.18</logback.version>
        <slf4j.version>2.0.9</slf4j.version>
        <junit.version>5.10.0</junit.version>
        <mockito.version>5.18.0</mockito.version>
        <assertj.version>3.25.1</assertj.version>
        <langchain4j.version>1.13.1</langchain4j.version>
        <langchain4j-community.version>1.13.1-beta23</langchain4j-community.version>
        <bytebuddy.version>1.17.5</bytebuddy.version>
        <langchain4j-mcp.version>1.13.1-beta23</langchain4j-mcp.version>
        <langchain4j-apache-tika.version>1.13.1-beta23</langchain4j-apache-tika.version>
        <langchain4j-jsoup.version>1.13.1-beta23</langchain4j-jsoup.version>
        <atlantafx.version>2.1.0</atlantafx.version>
        <controlsfx.version>11.2.2</controlsfx.version>
        <ikonli.version>12.3.1</ikonli.version>
        <cssfx.version>11.5.1</cssfx.version>
    </properties>

    <modules>
        <module>core</module>
        <module>ui</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- LangChain4J dependencies -->
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j</artifactId>
                <version>${langchain4j.version}</version>
            </dependency>
            
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-open-ai</artifactId>
                <version>${langchain4j.version}</version>
            </dependency>
            
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-ollama</artifactId>
                <version>${langchain4j.version}</version>
            </dependency>

            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-google-ai-gemini</artifactId>
                <version>${langchain4j.version}</version>
            </dependency>

            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-mcp</artifactId>
                <version>${langchain4j-mcp.version}</version>
            </dependency>

            <!-- apache tika documents -->
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-document-parser-apache-tika</artifactId>
                <version>${langchain4j-apache-tika.version}</version>
            </dependency>
            <!-- document transformer jsoup -->
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-document-transformer-jsoup</artifactId>
                <version>${langchain4j-jsoup.version}</version>
            </dependency>
            <!-- local code execution engine -->
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-community-code-execution-engine-local</artifactId>
                <version>${langchain4j-community.version}</version>
            </dependency>
        <!-- 
            Jackson-datatype-jsr310 is a necessary 
            dependency as long as the project stays on Jackson 2.x (which is dictated by LangChain4j). Once Jackson 3.x becomes mainstream and LangChain4j adopts it, the separate module will no longer be needed. 
            -->
            <dependency>
                <groupId>com.fasterxml.jackson.datatype</groupId>
                <artifactId>jackson-datatype-jsr310</artifactId>
                <version>2.21.1</version>
            </dependency>

        <!-- Configuration management -->
            <dependency>
                <groupId>com.typesafe</groupId>
                <artifactId>config</artifactId>
                <version>${typesafe-config.version}</version>
            </dependency>
            
            <!-- Logging implementation -->
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-classic</artifactId>
                <version>${logback.version}</version>
            </dependency>
            
            <!-- Core dependencies -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            
            <dependency>
                <groupId>one.jpro.platform</groupId>
                <artifactId>jpro-mdfx</artifactId>
                <version>${jpro.version}</version>
            </dependency>

            <!-- AtlantaFX – modern JavaFX CSS theme (PrimerLight/Dark, Nord, Cupertino, Dracula). -->
            <dependency>
                <groupId>io.github.mkpaz</groupId>
                <artifactId>atlantafx-base</artifactId>
                <version>${atlantafx.version}</version>
            </dependency>

            <dependency>
                <groupId>org.controlsfx</groupId>
                <artifactId>controlsfx</artifactId>
                <version>${controlsfx.version}</version>
            </dependency>

            <!-- Ikonli – icon packs for JavaFX (Feather set used across the UI). -->
            <dependency>
                <groupId>org.kordamp.ikonli</groupId>
                <artifactId>ikonli-javafx</artifactId>
                <version>${ikonli.version}</version>
            </dependency>

            <dependency>
                <groupId>org.kordamp.ikonli</groupId>
                <artifactId>ikonli-feather-pack</artifactId>
                <version>${ikonli.version}</version>
            </dependency>

            <!-- CSSFX – live CSS hot-reload, dev-only. -->
            <dependency>
                <groupId>fr.brouillard.oss</groupId>
                <artifactId>cssfx</artifactId>
                <version>${cssfx.version}</version>
            </dependency>

            <!-- Testing dependencies -->           
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-params</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-junit-jupiter</artifactId>            
                <version>${mockito.version}</version>
                <scope>test</scope>
            </dependency>

            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
                <scope>test</scope>
            </dependency>

            <!--
                Pin ByteBuddy to a JDK 25-compatible version. assertj-core 3.25.1
                otherwise drags in byte-buddy 1.14.11 which cannot read class
                file version 69 and breaks Mockito's inline mock maker.
            -->
            <dependency>
                <groupId>net.bytebuddy</groupId>
                <artifactId>byte-buddy</artifactId>
                <version>${bytebuddy.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>net.bytebuddy</groupId>
                <artifactId>byte-buddy-agent</artifactId>
                <version>${bytebuddy.version}</version>
                <scope>test</scope>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <source>25</source>
                        <target>25</target>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.1.2</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project> 